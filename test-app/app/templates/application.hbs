{{page-title "ember-gridstack"}}

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="#top">ember-gridstack</a>
    <nav class="site-nav" aria-label="Sections">
      <a href="#install">Install</a>
      <a href="#demo">Demo</a>
      <a href="#usage">Usage</a>
      <a href="#api">API</a>
      <a href="https://github.com/yahoo/ember-gridstack">GitHub</a>
    </nav>
  </div>
</header>

<main class="page" id="top">
  <section class="intro">
    <h1>ember-gridstack</h1>
    <p class="lede">
      Ember components for
      <a href="https://gridstackjs.com/">gridstack.js</a>. Build dashboards
      whose widgets can be dragged, resized and rearranged, with layout state
      kept in gridstack.js and content rendered by Ember.
    </p>
    <p class="meta">Ember 4.12+ · gridstack.js 12 · Embroider-ready v2 addon</p>
  </section>

  <section id="install">
    <h2>Install</h2>
    <pre class="code"><code
        class="language-bash"
        {{highlight}}
      >{{this.snippets.install}}</code></pre>
  </section>

  <section id="demo">
    <h2>Demo</h2>
    <p>
      Drag a widget by its body, resize it from the bottom-right corner. With
      <code>float</code>
      off, widgets move up to fill empty rows.
    </p>

    <div class="toolbar">
      <button type="button" class="button" {{on "click" this.changeItems}}>
        Add widget
      </button>
      <label class="switch">
        <input
          type="checkbox"
          role="switch"
          aria-checked={{if this.shouldFloat "true" "false"}}
          checked={{this.shouldFloat}}
          {{on "change" this.toggleFloat}}
        />
        <span>float</span>
      </label>
      <span class="event-log">Last event:
        <code>{{this.lastEvent}}</code></span>
    </div>

    <div class="example">
      <div class="example-preview">
        <GridStack
          @onChange={{this.logChange}}
          @options={{hash float=this.shouldFloat cellHeight=80 margin=6}}
        >
          <GridStackItem @options={{hash x=0 y=0 w=3 h=2}}>
            <StatWidget
              @label="Requests / min"
              @value="12,480"
              @delta="+3.2% w/w"
            />
          </GridStackItem>

          <GridStackItem @options={{hash x=3 y=0 w=3 h=2}}>
            <StatWidget
              @label="Error rate"
              @value="0.42%"
              @delta="+0.05 pts"
              @negative={{true}}
            />
          </GridStackItem>

          <GridStackItem @options={{hash x=6 y=0 w=6 h=2}}>
            <div class="widget">
              <div class="widget-label">p95 latency (ms), last 12 h</div>
              <svg
                class="sparkline"
                viewBox="0 0 140 40"
                preserveAspectRatio="none"
                role="img"
                aria-label="p95 latency trending down from 212 to 168 ms"
              >
                <polyline points={{this.latencyPoints}} />
              </svg>
              <div class="widget-foot">212 → 168</div>
            </div>
          </GridStackItem>

          <GridStackItem @options={{hash x=0 y=2 w=6 h=3}}>
            <div class="widget">
              <div class="widget-label">Weekly traffic (k sessions)</div>
              <svg
                class="bars"
                viewBox="0 0 144 104"
                role="img"
                aria-label="Sessions per day, peaking Thursday at 73k"
              >
                {{#each this.bars as |bar|}}
                  <rect x={{bar.x}} y={{bar.y}} width="12" height={{bar.h}} />
                  <text x={{bar.x}} y="102">{{bar.label}}</text>
                {{/each}}
              </svg>
            </div>
          </GridStackItem>

          <GridStackItem @options={{hash x=6 y=2 w=6 h=3}}>
            <div class="widget">
              <div class="widget-label">Recent deploys</div>
              <ul class="list">
                {{#each this.deploys as |d|}}
                  <li>
                    <span class="list-main">{{d.service}}
                      <code>{{d.version}}</code></span>
                    <span class="list-aside">{{d.when}}</span>
                  </li>
                {{/each}}
              </ul>
            </div>
          </GridStackItem>

          {{#each this.items as |item|}}
            <GridStackItem @options={{hash w=3 h=2}}>
              <div class="widget">
                <div class="widget-label">Widget {{item.id}}</div>
                <p class="widget-body">Added at runtime.</p>
                <button
                  type="button"
                  class="button button-quiet"
                  {{on "click" (fn this.removeItem item)}}
                >Remove</button>
              </div>
            </GridStackItem>
          {{/each}}
        </GridStack>
      </div>
      <pre class="code"><code
          class="language-handlebars"
          {{highlight}}
        >{{this.snippets.demo}}</code></pre>
    </div>
  </section>

  <section id="usage">
    <h2>Usage</h2>

    <h3>Template tag</h3>
    <p>Import the components directly in
      <code>.gjs</code>
      or
      <code>.gts</code>
      files.</p>
    <pre class="code"><code
        class="language-javascript"
        {{highlight}}
      >{{this.snippets.templateTag}}</code></pre>

    <h3><code>&lt;GridStack&gt;</code></h3>
    <p>
      Creates the gridstack.js instance on insert and recreates it when
      <code>@options</code>
      change. Event actions run after render.
    </p>
    <pre class="code"><code
        class="language-handlebars"
        {{highlight}}
      >{{this.snippets.gridStack}}</code></pre>

    <h3><code>&lt;GridStackItem&gt;</code></h3>
    <p>
      Registers itself with the closest
      <code>&lt;GridStack&gt;</code>
      and is removed from the grid when it leaves the DOM. Changing
      <code>@options</code>
      calls
      <code>grid.update()</code>.
    </p>
    <pre class="code"><code
        class="language-handlebars"
        {{highlight}}
      >{{this.snippets.gridStackItem}}</code></pre>

    <h3><code>\{{gs-item-attributes}}</code> modifier</h3>
    <p>Used by
      <code>&lt;GridStackItem&gt;</code>; available for custom item markup.</p>
    <pre class="code"><code
        class="language-handlebars"
        {{highlight}}
      >{{this.snippets.modifier}}</code></pre>

    <h3><code>grid-stack-registry</code> service</h3>
    <p>Maps grid element ids to their
      <code>&lt;GridStack&gt;</code>
      components.</p>
    <pre class="code"><code
        class="language-javascript"
        {{highlight}}
      >{{this.snippets.service}}</code></pre>
  </section>

  <section id="api">
    <h2>API reference</h2>

    <h3><code>&lt;GridStack&gt;</code></h3>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Argument</th><th>Type</th><th>Description</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><code>@options</code></td>
            <td>object</td>
            <td>Passed to
              <code>GridStack.init</code>. See
              <a
                href="https://github.com/gridstack/gridstack.js/tree/master/doc#grid-options"
              >grid options</a>.</td>
          </tr>
          <tr>
            <td><code>@onAdded</code>,
              <code>@onChange</code>,
              <code>@onRemoved</code></td>
            <td>function</td>
            <td>Called with
              <code>(event, items)</code>
              when widgets are added, moved/resized or removed.</td>
          </tr>
          <tr>
            <td><code>@onDragstart</code>,
              <code>@onDrag</code>,
              <code>@onDragstop</code></td>
            <td>function</td>
            <td>Called with
              <code>(event, element)</code>
              during a drag.</td>
          </tr>
          <tr>
            <td><code>@onResizestart</code>,
              <code>@onResize</code>,
              <code>@onResizestop</code></td>
            <td>function</td>
            <td>Called with
              <code>(event, element)</code>
              during a resize.</td>
          </tr>
          <tr>
            <td><code>@onEnable</code>,
              <code>@onDisable</code>,
              <code>@onDropped</code></td>
            <td>function</td>
            <td>Forwarded gridstack.js events of the same name.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>Yields the component;
      <code>.gridStack</code>
      is the gridstack.js instance (or
      <code>null</code>
      before insert).</p>

    <h3><code>&lt;GridStackItem&gt;</code></h3>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Argument</th><th>Type</th><th>Description</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><code>@options</code></td>
            <td>object</td>
            <td>Item options such as
              <code>x</code>,
              <code>y</code>,
              <code>w</code>,
              <code>h</code>,
              <code>minW</code>,
              <code>noMove</code>. See
              <a
                href="https://github.com/gridstack/gridstack.js/tree/master/doc#item-options"
              >item options</a>.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>Yields the component;
      <code>.elm</code>
      is the
      <code>.grid-stack-item</code>
      element. Content is wrapped in
      <code>.grid-stack-item-content</code>.</p>

    <h3><code>grid-stack-registry</code></h3>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Method</th><th>Description</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><code>registerGrid(id, grid)</code></td>
            <td>Register a grid component under its element id.</td>
          </tr>
          <tr>
            <td><code>findGridComponent(element)</code></td>
            <td>Return the component for the closest
              <code>.grid-stack</code>
              ancestor, or
              <code>undefined</code>.</td>
          </tr>
          <tr>
            <td><code>unregisterGridComponent(id)</code></td>
            <td>Remove a grid from the registry.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</main>

