{
  "name": "test-app",
  "version": "0.0.0",
  "private": true,
  "description": "Test app and demo for ember-gridstack",
  "repository": "https://github.com/yahoo/ember-gridstack.git",
  "license": "BSD-3-Clause",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "vite",
    "test": "concurrently \"pnpm:lint\" \"pnpm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "NODE_ENV=development vite build --mode development && testem ci --port 0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/plugin-transform-runtime": "^8.1.2",
    "@babel/runtime": "^8.1.2",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.8.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.28",
    "@embroider/config-meta-loader": "^1.0.1",
    "@embroider/core": "^4.6.10",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.21.4",
    "@embroider/router": "^3.0.6",
    "@embroider/try": "^1.0.2",
    "@embroider/vite": "^1.8.0",
    "@eslint/js": "^10.0.0",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@rollup/plugin-babel": "^7.1.0",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "concurrently": "^9.2.1",
    "decorator-transforms": "^2.4.0",
    "ember-cli": "~7.4.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-eslint-parser": "^0.16.1",
    "ember-gridstack": "workspace:*",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.2.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.4.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^7.9.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.10.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^17.14.0",
    "highlight.js": "^11.3.1",
    "prettier": "^3.8.1",
    "prettier-plugin-ember-template-tag": "^2.1.4",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "testem": "^3.21.5",
    "vite": "^8.3.6"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "dependenciesMeta": {
    "ember-gridstack": {
      "injected": true
    }
  },
  "engines": {
    "node": ">= 20.19"
  },
  "ember": {
    "edition": "octane"
  },
  "volta": {
    "extends": "../package.json"
  }
}
