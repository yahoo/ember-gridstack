{
  "name": "ember-gridstack-monorepo",
  "version": "0.0.0",
  "private": true,
  "repository": "https://github.com/yahoo/ember-gridstack.git",
  "license": "BSD-3-Clause",
  "workspaces": [
    "ember-gridstack",
    "test-app"
  ],
  "scripts": {
    "build": "yarn workspace ember-gridstack build",
    "lint": "yarn workspace ember-gridstack lint && yarn workspace test-app lint",
    "lint:fix": "yarn workspace ember-gridstack lint:fix && yarn workspace test-app lint:fix",
    "prepare": "husky && yarn build",
    "start": "concurrently \"npm:start:*\" --restart-after 5000 --prefixColors auto",
    "start:addon": "yarn workspace ember-gridstack start --no-watch.clearScreen",
    "start:test-app": "yarn workspace test-app start",
    "test": "yarn lint && yarn test:ember",
    "test:ember": "yarn workspace test-app test:ember",
    "test:ember-compatibility": "yarn workspace test-app test:ember-compatibility",
    "semantic-release": "semantic-release",
    "commit": "commit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/prompt-cli": "^21.2.4",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "pretty-quick": "^4.2.2",
    "semantic-release": "^25.0.6"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "footer-max-line-length": [
        0
      ]
    }
  },
  "release": {
    "repositoryUrl": "https://github.com/yahoo/ember-gridstack.git",
    "branches": [
      "master",
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "pkgRoot": "ember-gridstack"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "volta": {
    "node": "22.23.5",
    "yarn": "1.22.22"
  }
}
