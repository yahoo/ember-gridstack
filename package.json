{
  "name": "ember-gridstack-monorepo",
  "version": "0.0.0",
  "private": true,
  "repository": "https://github.com/yahoo/ember-gridstack.git",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "pnpm --filter ember-gridstack build",
    "lint": "pnpm --filter '*' lint",
    "lint:fix": "pnpm --filter '*' lint:fix",
    "prepare": "husky && pnpm build",
    "start": "concurrently 'pnpm:start:*' --restart-after 5000 --prefixColors auto",
    "start:addon": "pnpm --filter ember-gridstack start --no-watch.clearScreen",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm lint && pnpm test:ember",
    "test:ember": "pnpm --filter '*' test:ember",
    "test:try": "./build-scripts/try-scenarios.sh",
    "semantic-release": "semantic-release",
    "commit": "commit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/prompt-cli": "^21.2.4",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "pretty-quick": "^4.2.2",
    "semantic-release": "^25.0.6"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "footer-max-line-length": [
        0
      ]
    }
  },
  "release": {
    "repositoryUrl": "https://github.com/yahoo/ember-gridstack.git",
    "branches": [
      "main",
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "pkgRoot": "ember-gridstack"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "volta": {
    "node": "22.23.5",
    "pnpm": "10.34.9"
  },
  "packageManager": "pnpm@10.34.9"
}
