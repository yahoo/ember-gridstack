{
  "name": "ember-gridstack-monorepo",
  "version": "0.0.0",
  "private": true,
  "repository": "https://github.com/yahoo/ember-gridstack.git",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "pnpm --filter ember-gridstack build",
    "lint": "pnpm --filter '*' lint",
    "lint:fix": "pnpm --filter '*' lint:fix",
    "prepare": "husky && pnpm build",
    "start": "concurrently 'pnpm:start:*' --restart-after 5000 --prefixColors auto",
    "start:addon": "pnpm --filter ember-gridstack start --no-watch.clearScreen",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm lint && pnpm test:ember",
    "test:ember": "pnpm --filter '*' test:ember",
    "test:try": "./build-scripts/try-scenarios.sh"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "pretty-quick": "^4.2.2",
    "release-plan": "^0.20.1"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "volta": {
    "node": "22.23.5",
    "pnpm": "10.34.9"
  },
  "packageManager": "pnpm@10.34.9"
}
